# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated localization code (flutter gen-l10n). Source ARB files under
# lib/l10n/*.arb are tracked; the generated Dart accessors are not.
lib/l10n/app_localizations*.dart
l10n_untranslated.json

# Generated freezed/json_serializable code (dart run build_runner build).
# The annotated source files are tracked; these companions are not.
**/*.freezed.dart
**/*.g.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# WiX Toolset's local extension cache (tool/package_windows.ps1), downloaded
# via `wix extension add` — a build tool artifact, not source.
/.wix/
